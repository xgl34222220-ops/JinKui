<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        金匮全程离线：不声明 INTERNET。
        下面两行让构建在任何依赖库试图带入联网权限时直接把它移除。
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 1.4：账单到期提醒的系统通知（默认关闭，打开开关时才向用户申请；Android 13 起需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        1.4.0-alpha04：图标资源改名为 ic_launcher_b / ic_launcher_b_round（内容就是 B 款）。仓库与 APK 里本来就没有旧“匣子”图标，
        但部分系统（HyperOS 的指纹解锁弹窗、桌面）按图标资源 ID 缓存应用图标，覆盖安装后仍显示旧图；
        换成新的资源名会得到新的资源 ID，系统缓存随之失效。应用、主界面、logo 三处都指向同一套 B 款图标。
    -->
    <application
        android:name=".JinKuiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_b"
        android:label="@string/app_name"
        android:logo="@mipmap/ic_launcher_b"
        android:roundIcon="@mipmap/ic_launcher_b_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JinKui"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_b"
            android:roundIcon="@mipmap/ic_launcher_b_round"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 桌面长按图标的“记一笔”快捷方式（静态快捷方式，不需要任何权限） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            自动记账（默认关闭）：读取微信 / 支付宝 / 银行 App 的收付款通知，生成“待确认”记录。
            android:permission 表示只有系统能绑定这个服务；它不是金匮申请的权限，
            用户要在系统设置里手动授予“通知使用权”才会生效，随时可以收回。
        -->
        <service
            android:name=".core.auto.PaymentNotificationService"
            android:exported="true"
            android:label="@string/auto_bookkeeping_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            1.4 账单到期提醒：只接收金匮自己用 AlarmManager 排的非精确闹钟（不导出、不需要精确闹钟或开机自启权限），
            到时发一条不含金额的通用通知。
        -->
        <receiver
            android:name=".core.debt.DebtReminderReceiver"
            android:exported="false" />

        <!--
            1.4.0-alpha04 快捷设置磁贴“记一笔”：android:permission 表示只有系统能绑定（金匮并不申请这个权限）。
            点一下打开金匮（照常要求解锁），解锁后直接打开记账面板；磁贴不读取、不显示任何数据。
        -->
        <service
            android:name=".core.quick.QuickRecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_record"
            android:label="@string/shortcut_record_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
            1.4.0-alpha04 桌面小部件“记一笔”：只有图标与文字，不显示金额或任何记录，锁定与否都一样；
            点一下打开金匮，解锁后直接打开记账面板。不导出（系统给小部件的广播是显式的）。
        -->
        <receiver
            android:name=".core.quick.QuickRecordWidget"
            android:exported="false"
            android:label="@string/shortcut_record_short">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_record" />
        </receiver>
    </application>
</manifest>
